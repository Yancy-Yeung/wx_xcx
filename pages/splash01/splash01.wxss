/* pages/splash/splash.wxss */
.splash-container {
    height  : 100vh;
    width   : 100%;
    position: relative;
    overflow: hidden;
}

/* 全屏背景图片 */
.background-image {
    position  : fixed;
    top       : 0;
    left      : 0;
    width     : 100%;
    height    : 100vh;
    z-index   : -1;
    object-fit: cover;
    /* 确保图片覆盖整个屏幕 */
}

/* 内容覆盖层 */
.content-overlay {
    position       : relative;
    height         : 100vh;
    width          : 100%;
    display        : flex;
    flex-direction : column;
    align-items    : center;
    justify-content: center;
    background     : rgba(0, 0, 0, 0.2);
    /* 添加半透明遮罩 */
}

.countdown {
    position     : absolute;
    top          : 95rpx;
    left         : 40rpx;
    color        : #fff;
    font-size    : 32rpx;
    font-weight  : bold;
    background   : rgba(0, 0, 0, 0.5);
    padding      : 10rpx 20rpx;
    border-radius: 30rpx;
    z-index      : 10;
}

.button-container {
    position       : absolute;
    bottom         : 100rpx;
    width          : 100%;
    display        : flex;
    justify-content: center;
    z-index        : 10;
}

.skip-btn {
    background     : rgba(255, 255, 255, 0.9);
    color          : #333;
    font-size      : 32rpx;
    font-weight    : bold;
    border-radius  : 50rpx;
    padding        : 20rpx 60rpx;
    border         : none;
    box-shadow     : 0 8rpx 20rpx rgba(0, 0, 0, 0.3);
    backdrop-filter: blur(10rpx);
}

.skip-btn:active {
    transform : translateY(2rpx);
    box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.3);
}