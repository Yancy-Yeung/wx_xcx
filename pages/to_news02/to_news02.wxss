.page-container {
    /* min-height: 100vh; */
    width   : 100%;
    position: relative;
    overflow: auto;
}

.header {
    margin : 40rpx 0 20rpx 0;
    padding: 0 32rpx;
}

.header-text {
    font-size  : 40rpx;
    font-weight: 600;
    color      : #222;
    line-height: 1.3;
}

.sub-info {
    margin-top : 18rpx;
    font-size  : 26rpx;
    color      : #b0b0b0;
    display    : flex;
    align-items: center;
    flex-wrap  : wrap;
}

.location {
    color       : #3b7cff;
    margin-right: 16rpx;
}

.sub-date {
    color       : #b0b0b0;
    margin-right: 16rpx;
}

.sub-area {
    color: #b0b0b0;
}

.imageTxt {
    width        : 100%;
    margin-top   : -10rpx;
    margin-bottom: -10rpx;
}

.imageTxt image {
    width  : 100%;
    display: block;
    height : auto;
}