@import "../../wxss/color.wxss";
@import "../../wxss/iconfont.wxss";

page {
  background: linear-gradient(180deg, #FFFFFF 0%, #FFFFFF 50%, #FFFFFF 100%);
  min-height: 100vh;
}

swiper {
  width        : 100%;
  height       : 520rpx;
  margin       : 0;
  margin-top   : 0;
  border-radius: 0;
}

swiper image {
  width        : 100%;
  border-radius: 0rpx;
  height       : 520rpx;
  box-shadow   : 0 8rpx 14rpx rgba(135, 206, 235, 0.3);
}

/* 功能按钮区域样式 */
.function-tabs {
  background   : linear-gradient(180deg, #e9eadd 0%, #e5f1f1 50%, #d9eadd 100%);
  padding      : 10rpx 10rpx;
  margin-top   : 10rpx;
  border-radius: 0rpx;
  border       : 2rpx solid rgba(135, 206, 235, 0.1);
}

.tab-row {
  display        : flex;
  justify-content: space-between;
  margin-bottom  : 40rpx;
}

.tab-row:last-child {
  margin-bottom: 0;
}

.tab-item {
  display       : flex;
  flex-direction: column;
  align-items   : center;
  width         : 140rpx;
  padding       : 20rpx 10rpx;
  border-radius : 20rpx;
  transition    : all 0.3s ease;
}

.tab-icon {
  width             : 100rpx;
  height            : 100rpx;
  border-radius     : 25rpx;
  border            : 1px solid #2F4F4F;
  /* background     : linear-gradient(135deg, #87CEEB 0%, #fafafa 100%); */
  display           : flex;
  align-items       : center;
  justify-content   : center;
  margin-bottom     : 16rpx;
}

.tab-icon .image {
  font-size: 36rpx;
  color    : #ffffff;
}

.tab-text {
  font-size  : 24rpx;
  color      : #2F4F4F;
  text-align : center;
  line-height: 1.2;
  font-weight: 600;
}

/* Tabs组件样式 */
.tabs-container {
  background   : linear-gradient(135deg, #FFFFFF 0%, #F0F8FF 100%);
  margin-top   : 10rpx;
  border-radius: 25rpx;
  overflow     : hidden;
  border       : 2rpx solid rgba(135, 206, 235, 0.1);
}

/* Tab标签栏样式 */
.tabs-header {
  display      : flex;
  background   : linear-gradient(135deg, #E0F6FF 0%, #B0E0E6 100%);
  border-bottom: 2rpx solid rgba(135, 206, 235, 0.2);
}

.tab-header-item {
  flex      : 1;
  padding   : 30rpx 20rpx;
  text-align: center;
  position  : relative;
  transition: all 0.3s ease;
}

.tab-header-item.active {
  background: linear-gradient(135deg, #FFFFFF 0%, #F0F8FF 100%);
  color     : #4682B4;
}

.tab-header-item.active::after {
  content      : '';
  position     : absolute;
  bottom       : 0;
  left         : 0;
  right        : 0;
  height       : 6rpx;
  background   : linear-gradient(135deg, #87CEEB 0%, #4682B4 100%);
  border-radius: 3rpx 3rpx 0 0;
}

.tab-header-text {
  font-size  : 28rpx;
  font-weight: 500;
  color      : #708090;
}

.tab-header-item.active .tab-header-text {
  color      : #4682B4;
  font-weight: 600;
}

/* Tab内容区域样式 */
.tabs-content {
  position  : relative;
  height    : 450rpx;
  /* 固定高度 */
  overflow-y: auto;
  /* 滚动显示 */
  background: rgba(255, 255, 255, 0.8);
}

.tab-content {
  display  : none;
  padding  : 30rpx;
  animation: fadeIn 0.3s ease-in-out;
}

.tab-content.active {
  display: block;
}

@keyframes fadeIn {
  from {
    opacity  : 0;
    transform: translateY(20rpx);
  }

  to {
    opacity  : 1;
    transform: translateY(0);
  }
}

/* 内容列表样式 */
.content-list {
  display       : flex;
  flex-direction: column;
  gap           : 20rpx;
}

.content-item {
  display      : flex;
  align-items  : center;
  padding      : 25rpx;
  background   : linear-gradient(135deg, #F0F8FF 0%, #E6F3FF 100%);
  border-radius: 20rpx;
  border-left  : 6rpx solid #87CEEB;
  transition   : all 0.3s ease;
}

.content-item:hover {
  background: linear-gradient(135deg, #E0F6FF 0%, #DDEEFF 100%);
  transform : translateX(10rpx);
}

.item-icon {
  font-size   : 40rpx;
  margin-right: 25rpx;
  width       : 60rpx;
  text-align  : center;
}

.item-info {
  flex          : 1;
  display       : flex;
  flex-direction: column;
}

.item-title {
  font-size    : 30rpx;
  font-weight  : 600;
  color        : #2F4F4F;
  margin-bottom: 8rpx;
}

.item-desc {
  font-size  : 24rpx;
  color      : #708090;
  line-height: 1.4;
}

/* 卡片式信息样式 */
.card {
  display       : flex;
  flex-direction: column;
  align-items   : center;
  background    : linear-gradient(135deg, #F0F8FF 0%, #E6F3FF 100%);
  border-radius : 20rpx;
  box-shadow    : 0 4rpx 16rpx rgba(135, 206, 235, 0.10);
  padding       : 0 0 24rpx 0;
  margin-bottom : 20rpx;
  border        : 2rpx solid #e0f6ff;
  overflow      : hidden;
}

.card-img-wrap {
  width                  : 100%;
  height                 : 180rpx;
  overflow               : hidden;
  border-top-left-radius : 20rpx;
  border-top-right-radius: 20rpx;
}

.card-img {
  width     : 100%;
  height    : 180rpx;
  object-fit: cover;
  display   : block;
}

.card-info {
  width         : 92%;
  margin        : 0 auto;
  padding-top   : 18rpx;
  display       : flex;
  flex-direction: column;
  align-items   : flex-start;
}

.card-title {
  font-size    : 30rpx;
  font-weight  : 600;
  color        : #2F4F4F;
  margin-bottom: 10rpx;
}

.card-desc {
  font-size  : 24rpx;
  color      : #708090;
  line-height: 1.6;
}