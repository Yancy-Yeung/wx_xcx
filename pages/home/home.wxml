<swiper
  indicator-dots="{{ indicatorDots }}"
  autoplay="true"
  interval="9000"
  duration="2000"
  circular="true"
>
  <block wx:for="{{ imgUrls }}" wx:key="{{ imgUrls }}">
    <swiper-item>
      <image src="{{ item.img }}" class="slide-image" />
    </swiper-item>
  </block>
</swiper>

<!-- 功能按钮区域 -->
<view class="function-tabs">
  <!-- 第1行 -->
  <view class="tab-row">
    <view class="tab-item" bindtap="toPlaneSearch" data-type="service">
      <view class="tab-icon">        
        <text class="iconfont icon-airlines ft-blue"></text>     
      </view>
      <text class="tab-text">Flight</text>
    </view>
    <view class="tab-item" bindtap="onTabClick" data-type="departure">
      <view class="tab-icon">
        <text class="iconfont icon-ship ft-blue"></text>
        
      </view>
      <text class="tab-text">Shipping</text>
    </view>
    <view class="tab-item" bindtap="onTabClick" data-type="arrive">
      <view class="tab-icon">
        <text class="iconfont icon-jiaoshui ft-blue"></text>           
      </view>
      <text class="tab-text">Tax Refund</text>
    </view>
    <view class="tab-item" bindtap="onTabClick" data-type="transfer">
      <view class="tab-icon">
        <text class="iconfont icon-airLine ft-blue"></text>
      </view>
      <text class="tab-text"></text>
    </view>
  </view>

  <!-- 第2行 -->
  <view class="tab-row">
    <view class="tab-item" bindtap="toPlaneSearch" data-type="service">
      <view class="tab-icon">
        <text class="iconfont icon-airline_luggage ft-blue"></text>
      </view>
      <text class="tab-text"></text>
    </view>
    <view class="tab-item" bindtap="onTabClick" data-type="departure">
      <view class="tab-icon">
        <text class="iconfont icon-ticket-airline ft-blue"></text>        
      </view>
      <text class="tab-text"></text>
    </view>
    <view class="tab-item" bindtap="onTabClick" data-type="arrive">
      <view class="tab-icon">
        <text class="iconfont icon-yinhangqia ft-blue"></text>        
      </view>
      <text class="tab-text"></text>
    </view>
    <view class="tab-item" bindtap="onTabClick" data-type="transfer">
      <view class="tab-icon">
        <text class="iconfont icon-kefu ft-blue"></text>        
      </view>
      <text class="tab-text"></text>
    </view>
  </view>
</view>

<!-- Tabs组件 -->
<view class="tabs-container">
  <!-- Tab标签栏 -->
  <view class="tabs-header">
    <view
      class="tab-header-item {{ activeTab === 0 ? 'active' : '' }}"
      bindtap="onTabChange"
      data-index="0"
    >
      <text class="tab-header-text"><i class="iconfont icon-airline_luggage ft-green"></i>最新消息</text>
    </view>
    <view
      class="tab-header-item {{ activeTab === 1 ? 'active' : '' }}"
      bindtap="onTabChange"
      data-index="1"
    >
      <!-- <text class="tab-header-text">交通行程</text> -->
    </view>
    <view
      class="tab-header-item {{ activeTab === 2 ? 'active' : '' }}"
      bindtap="onTabChange"
      data-index="2"
    >
      <!-- <text class="tab-header-text">旅客工具</text> -->
    </view>
    <view
    class="tab-header-item {{ activeTab === 3 ? 'active' : '' }}"
    bindtap="onTabChange"
    data-index="3"
  >
    <!-- <text class="tab-header-text">聯絡我們</text> -->
  </view>
  </view>

  <!-- Tab内容区域 -->
  <view class="tabs-content">
    <!-- 热门推荐 -->
    <view class="tab-content {{ activeTab === 0 ? 'active' : '' }}">
      <view class="content-list">
        <view class="content-item" bindtap="onToNews" >
          <view class="item-icon">
            <text class="iconfont icon-ethiopianairlines ft-blue"></text>
          </view>
          <view class="item-info">
            <text class="item-title">公众通知</text>
            <text class="item-desc">香港国际机场客运大楼实施进出管制安排</text>
          </view>
        </view>
        <view class="content-item">
          <view class="item-icon">
            <text class="iconfont icon-chinaeasternairlines ft-blue"></text>
          </view>
          <view class="item-info">
            <text class="item-title">无障碍浏览声明</text>
            <text class="item-desc">香港国际机场网站的设计考虑到视障人士的需要，并获得「2020 无障碍网页嘉许计划」三年卓越表现奖（网站组别）。该嘉许计划由香港互联网注册管理有限公司主办、政府资讯科技总监办公室协办，以及平等机会委员会担任顾问。</text>
          </view>
        </view>
        <view class="content-item">
          <view class="item-icon">
            <text class="iconfont icon-ic_airlines ft-blue"></text>
          </view>
          <view class="item-info">
            <text class="item-title">免税店优惠</text>
            <text class="item-desc">专属折扣，限时优惠活动</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 交通行程 -->
    <view class="tab-content {{ activeTab === 1 ? 'active' : '' }}">
      <view class="content-list">        
        <view class="content-item">
          <view class="item-icon">🚌</view>
          <view class="item-info">
            <text class="item-title">机场巴士</text>
            <text class="item-desc">查看巴士时刻表和路线</text>
          </view>
        </view>
        <view class="content-item">
            <view class="item-icon">🗺️</view>
            <view class="item-info">
              <text class="item-title">机场地图</text>
              <text class="item-desc">查看机场内部导航地图</text>
            </view>
          </view>
        <view class="content-item">
          <view class="item-icon">🍽️</view>
          <view class="item-info">
            <text class="item-title">餐厅预订</text>
            <text class="item-desc">提前预订机场餐厅座位</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 旅客工具 -->
    <view class="tab-content {{ activeTab === 2 ? 'active' : '' }}">
      <view class="content-list">
        <view class="content-item">
            <view class="item-icon">🛄</view>
            <view class="item-info">
              <text class="item-title">行李托运</text>
              <text class="item-desc">在线办理行李托运服务</text>
            </view>
          </view>
        <view class="content-item">
          <view class="item-icon">🌤️</view>
          <view class="item-info">
            <text class="item-title">天气查询</text>
            <text class="item-desc">目的地天气预报</text>
          </view>
        </view>
        <view class="content-item">
          <view class="item-icon">💱</view>
          <view class="item-info">
            <text class="item-title">汇率换算</text>
            <text class="item-desc">实时汇率计算器</text>
          </view>
        </view>        
      </view>
    </view>
    <!-- 联络我们 -->
    <view class="tab-content {{ activeTab === 3 ? 'active' : '' }}">
      <view class="content-list">
        <view class="content-item">
            <view class="item-icon">🛄</view>
            <view class="item-info">
              <text class="item-title">机场热线</text>
              <text class="item-desc"></text>
            </view>
          </view>
        <view class="content-item">
          <view class="item-icon">🌤️</view>
          <view class="item-info">
            <text class="item-title">失物认领</text>
            <text class="item-desc"></text>
          </view>
        </view>
        <view class="content-item">
          <view class="item-icon">💱</view>
          <view class="item-info">
            <text class="item-title">旅客辅助</text>
            <text class="item-desc"></text>
          </view>
        </view>
        <view class="content-item">
            <view class="item-icon">💱</view>
            <view class="item-info">
              <text class="item-title">行李寄存及快递</text>
              <text class="item-desc"></text>
            </view>
        </view>      
        <view class="content-item">
            <view class="item-icon">💱</view>
            <view class="item-info">
              <text class="item-title">停车场</text>
              <text class="item-desc"></text>
            </view>
        </view>   
        <view class="content-item">
            <view class="item-icon">💱</view>
            <view class="item-info">
              <text class="item-title">民航处</text>
              <text class="item-desc"></text>
            </view>
        </view>      
      </view>
    </view>
  </view>
</view>
